# ===========================================================================
# AILT9019 Grammar Analysis Backend – Environment Variables
# ===========================================================================
#
# Copy this file to .env and fill in your values.
# NEVER commit the real .env to version control (it is in .gitignore).
#
# These variables are read by analyzer.py at runtime.
# They are used by the OpenAI Python SDK to talk to any
# OpenAI-compatible chat completions endpoint.
#
# ---------------------------------------------------------------------------
# IMPORTANT: You need your own authorized inference API key
# ---------------------------------------------------------------------------
#
# This application requires an API key from an authorized inference
# provider.  You must obtain your own key — do NOT reuse credentials
# from other tools, coding agents, or shared subscriptions unless the
# provider's terms explicitly allow it.
#
# Examples of compatible providers:
#   - Alibaba Cloud DashScope / Model Studio  (Qwen models)
#       Base URL:  https://dashscope.aliyuncs.com/compatible-mode/v1
#       Sign up:   https://dashscope.console.aliyun.com/
#
#   - OpenAI  (GPT models)
#       Base URL:  https://api.openai.com/v1
#       Sign up:   https://platform.openai.com/
#
#   - Any other OpenAI-compatible endpoint
#
# ---------------------------------------------------------------------------

# Base URL of the OpenAI-compatible API endpoint.
# Examples:
#   DashScope:  https://dashscope.aliyuncs.com/compatible-mode/v1
#   OpenAI:     https://api.openai.com/v1
OPENAI_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1

# Your API key.  Keep this secret — never share or commit it.
OPENAI_API_KEY=sk-your-key-here

# The model identifier to use for grammar analysis.
# Examples:  qwen-plus, qwen-max, gpt-4o, gpt-3.5-turbo
# Choose a model available on your chosen provider.
OPENAI_MODEL=qwen-plus
